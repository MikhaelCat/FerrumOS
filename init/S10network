#!/bin/sh
# FerrumOS Network & Bridge Configuration
# Creates br0 for LAN (eth2.1 + ra0 2.4G + rai0 5G)
# Sets up loopback and WAN DHCP

set -e

echo "[FerrumOS] Setting up network bridge and interfaces..."

# Loopback
ip link set lo up || ifconfig lo 127.0.0.1 up

# Bridge for LAN
if ! brctl show | grep -q br0; then
    brctl addbr br0
fi

# Add LAN ethernet to bridge
brctl addif br0 eth2.1 2>/dev/null || true

# Add Wireless if available
if ip link show ra0 >/dev/null 2>&1; then
    brctl addif br0 ra0 2>/dev/null || true
fi
if ip link show rai0 >/dev/null 2>&1; then
    brctl addif br0 rai0 2>/dev/null || true
fi

# Set default LAN IP
ifconfig br0 192.168.1.1 netmask 255.255.255.0 up

# System & Memory Optimizations for 64MB RAM router
sysctl -w vm.min_free_kbytes=2048 2>/dev/null || true
sysctl -w vm.dirty_ratio=10 2>/dev/null || true
sysctl -w vm.dirty_background_ratio=5 2>/dev/null || true
sysctl -w vm.swappiness=0 2>/dev/null || true
sysctl -w net.core.somaxconn=512 2>/dev/null || true
sysctl -w net.ipv4.tcp_fin_timeout=15 2>/dev/null || true
sysctl -w net.ipv4.tcp_tw_reuse=1 2>/dev/null || true

# IP Forwarding & Conntrack Tuning for Zero-Drop Client VPNs (Hysteria, WireGuard, IPsec, OpenVPN)
sysctl -w net.ipv4.ip_forward=1 2>/dev/null || true
sysctl -w net.netfilter.nf_conntrack_tcp_be_liberal=1 2>/dev/null || true
sysctl -w net.netfilter.nf_conntrack_udp_timeout=60 2>/dev/null || true
sysctl -w net.netfilter.nf_conntrack_udp_timeout_stream=300 2>/dev/null || true
sysctl -w net.netfilter.nf_conntrack_generic_timeout=120 2>/dev/null || true

# Ensure Core Firewall FORWARD chain smoothly passes client VPN traffic without dropping
iptables -I FORWARD -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
iptables -I FORWARD -i br0 -j ACCEPT 2>/dev/null || true
iptables -I FORWARD -p udp -m multiport --dports 443,500,1194,1701,4500,51820,41641,9993,3478 -j ACCEPT 2>/dev/null || true
iptables -I FORWARD -p 50 -j ACCEPT 2>/dev/null || true
iptables -I FORWARD -p 51 -j ACCEPT 2>/dev/null || true
iptables -I FORWARD -p 47 -j ACCEPT 2>/dev/null || true
iptables -I FORWARD -p icmp -j ACCEPT 2>/dev/null || true

# Clamp TCP MSS to prevent fragmentation black holes on encapsulated packets
iptables -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true

# Hardware NAT / PPE Acceleration: 0% CPU for line-rate routing
echo 1 > /proc/sys/net/nat/fast_nat 2>/dev/null || true

# WAN configuration (DHCP client on eth2.2)
udhcpc -i eth2.2 -p /var/run/udhcpc.eth2.2.pid -s /usr/share/udhcpc/default.script -b &

echo "[FerrumOS] LAN running on 192.168.1.1. WAN client started."

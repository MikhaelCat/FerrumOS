#!/bin/sh
# FerrumOS Network & Bridge Configuration
# Creates br0 for LAN (eth2.1 + ra0 2.4G + rai0 5G)
# Sets up loopback and WAN DHCP

set -e

echo "[FerrumOS] Setting up network bridge and interfaces..."

# Loopback
ip link set lo up || ifconfig lo 127.0.0.1 up

# Bridge for LAN
if ! brctl show | grep -q br0; then
    brctl addbr br0
fi

# Add LAN ethernet to bridge
brctl addif br0 eth2.1 2>/dev/null || true

# Add Wireless if available
if ip link show ra0 >/dev/null 2>&1; then
    brctl addif br0 ra0 2>/dev/null || true
fi
if ip link show rai0 >/dev/null 2>&1; then
    brctl addif br0 rai0 2>/dev/null || true
fi

# Set default LAN IP
ifconfig br0 192.168.1.1 netmask 255.255.255.0 up

# WAN configuration (DHCP client on eth2.2)
udhcpc -i eth2.2 -p /var/run/udhcpc.eth2.2.pid -s /usr/share/udhcpc/default.script -b &

echo "[FerrumOS] LAN running on 192.168.1.1. WAN client started."

#!/bin/sh
# FerrumOS Zapret NFQWS DPI Circumvention Service
# Restores YouTube 4K playback and Discord voice/media in Russia without VPN
# Ensures zero packet loss and preserves all QUIC/UDP (Hysteria 2 / TUIC) traffic

NFQWS="/usr/bin/nfqws"
QNUM=200

flush_zapret_rules() {
    # Thoroughly flush all duplicate rules until iptables -D returns non-zero
    while iptables -D FORWARD -p udp --dport 443 -j REJECT --reject-with icmp-port-unreachable 2>/dev/null; do :; done
    while iptables -D FORWARD -p udp --dport 443 -j DROP 2>/dev/null; do :; done
    while iptables -t mangle -D POSTROUTING -p udp --dport 443 -j DROP 2>/dev/null; do :; done
    while iptables -t mangle -D POSTROUTING -p tcp -m multiport --dports 80,443 -m connbytes --connbytes-dir=original --connbytes-mode=packets --connbytes 1:6 -j NFQUEUE --queue-num $QNUM --queue-bypass 2>/dev/null; do :; done
    while iptables -t mangle -D POSTROUTING -p tcp -m multiport --dports 80,443 -m connbytes --connbytes-dir=original --connbytes-mode=packets --connbytes 1:6 -j NFQUEUE --queue-num $QNUM 2>/dev/null; do :; done
    while iptables -t mangle -D POSTROUTING -p tcp -m multiport --dports 80,443 -j ZAPRET_NFQ 2>/dev/null; do :; done
    while iptables -t mangle -D POSTROUTING -p udp --dport 50000:65535 -j ZAPRET_NFQ 2>/dev/null; do :; done
    while iptables -t mangle -D POSTROUTING -p udp --dport 50000:65535 -j NFQUEUE --queue-num $QNUM --queue-bypass 2>/dev/null; do :; done
    while iptables -t mangle -D POSTROUTING -p udp --dport 50000:65535 -j NFQUEUE --queue-num $QNUM 2>/dev/null; do :; done
    iptables -t mangle -F ZAPRET_NFQ 2>/dev/null || true
    iptables -t mangle -X ZAPRET_NFQ 2>/dev/null || true
}

start_zapret() {
    echo "[FerrumOS] Starting Zapret NFQWS DPI bypass..."

    # Ensure NFQUEUE kernel module is loaded
    modprobe xt_NFQUEUE 2>/dev/null || true

    # Clean old iptables rules to prevent duplicate entries
    flush_zapret_rules

    # YouTube 4K & HTTPS bypass: Send initial TLS/HTTP packets to NFQUEUE with --queue-bypass
    # CRITICAL: --queue-bypass guarantees that packets are NEVER dropped even if nfqws is busy or restarting!
    # NOTE: UDP 443 (QUIC / Hysteria 2) is NEVER blocked, guaranteeing high-speed UDP tunnels for phones & PCs.
    iptables -t mangle -A POSTROUTING -p tcp -m multiport --dports 80,443 -m connbytes --connbytes-dir=original --connbytes-mode=packets --connbytes 1:6 -j NFQUEUE --queue-num $QNUM --queue-bypass
    
    # Discord Voice UDP (Voice IP Discovery)
    iptables -t mangle -A POSTROUTING -p udp --dport 50000:65535 -j NFQUEUE --queue-num $QNUM --queue-bypass 2>/dev/null || true

    # Launch nfqws with selected strategy preset (or custom args)
    ARGS="--qnum=$QNUM --dpi-desync=fake,multisplit --dpi-desync-split-pos=1,midsld --dpi-desync-fooling=badseq --dpi-desync-cutoff=d4 --dpi-desync-repeats=2 --dpi-desync-any-protocol"
    if [ -f /etc/zapret/nfqws.args ]; then
        ARGS="$(cat /etc/zapret/nfqws.args)"
    elif [ -f /etc/storage/zapret/nfqws.args ]; then
        ARGS="$(cat /etc/storage/zapret/nfqws.args)"
    fi

    $NFQWS $ARGS --daemon

    echo "[FerrumOS] Zapret active: YouTube 4K and Discord voice unblocked."
}

stop_zapret() {
    echo "[FerrumOS] Stopping Zapret..."
    killall nfqws 2>/dev/null || true
    flush_zapret_rules
}

case "$1" in
    start) start_zapret ;;
    stop) stop_zapret ;;
    restart) stop_zapret; sleep 1; start_zapret ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
